{
    "name":  "dsh-git-panel",
    "version":  "0.1.16",
    "description":  "DSH web GUI git panel: branch management, commit graph, VS Code-style side-by-side diff with merge-conflict resolution, and workspace file-tree change badges.",
    "license":  "MIT",
    "author":  "Jaden Tang \u003cjaden.tang@sjfood.com\u003e",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/a792883583/dsh-git-panel.git"
                   },
    "homepage":  "https://github.com/a792883583/dsh-git-panel",
    "bugs":  {
                 "url":  "https://github.com/a792883583/dsh-git-panel/issues"
             },
    "keywords":  [
                     "dsh",
                     "plugin",
                     "git",
                     "branch",
                     "commit-graph",
                     "panel",
                     "diff",
                     "merge-conflict"
                 ],
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "types":  "./lib/types/client/index.d.ts",
                                     "default":  "./lib/client.js"
                                 },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md",
                  "README.en.md",
                  "README.es.md",
                  "docs",
                  "LICENSE",
                  "CHANGELOG.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-sidebar-right"
                                          ],
                               "platform":  "web"
                           }
            },
    "scripts":  {
                    "build":  "node scripts/build.mjs",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "bash scripts/test-e2e.sh"
                },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-client-locale":  "\u003e=0.1.0-rc.6 \u003c0.3.0",
                             "@deepseek-ai/dsh-client-runtime":  "\u003e=0.1.0-rc.6 \u003c0.3.0",
                             "@deepseek-ai/dsh-host-webserver":  "\u003e=0.1.0-rc.6 \u003c0.3.0",
                             "@deepseek-ai/dsh-subprocess":  "\u003e=0.1.0-rc.6 \u003c0.3.0",
                             "@deepseek-ai/dsh-workspace":  "\u003e=0.1.0-rc.6 \u003c0.3.0",
                             "react":  "\u003e=16.8.0 \u003c20.0.0",
                             "@deepseek-ai/dsh-client-ui-sidebar-right":  "\u003e=0.1.5-alpha.1 \u003c0.3.0",
                             "@deepseek-ai/dsh-client-ui-sidebar-documentpreview":  "\u003e=0.1.5-alpha.1 \u003c0.3.0"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/dsh-client-ui-sidebar-documentpreview":  {
                                                                                            "optional":  true
                                                                                        }
                             },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.1",
                            "@deepseek-ai/dsh-client-locale":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-runtime":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-ui-slots":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-host-webserver":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-subprocess":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-workspace":  "^0.1.0-rc.6",
                            "@types/node":  "^22.0.0",
                            "@types/react":  "^18.3.0",
                            "@types/react-dom":  "^18.3.0",
                            "esbuild":  "^0.25.0",
                            "react":  "^18.3.1",
                            "react-dom":  "^18.3.1",
                            "typescript":  "^5.6.0"
                        }
}
